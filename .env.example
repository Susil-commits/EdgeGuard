# EdgeGuard environment variables — copy to .env and fill in secrets
# Never commit .env to git.

# Database
DATABASE_URL=postgresql+asyncpg://edgeguard:edgeguard@db:5432/edgeguard

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# EDA runner webhook URL
EDA_WEBHOOK_URL=http://eda-runner:5000

# Service-to-service token (used by EDA runner to call back to /v1/automation/jobs/{id}/result)
EDGEGUARD_SERVICE_TOKEN=change-me-in-production

# Grafana
GRAFANA_PASSWORD=admin

# Agent (set on the edge node, not in docker-compose)
# EDGEGUARD_API_URL=https://your-api-host:8443
# NODE_ID=<uuid from /v1/nodes/register response>
# AGENT_TOKEN=<jwt for the agent's service account>
# MONITORED_SERVICES=sshd,chronyd,podman
# COLLECT_INTERVAL_S=30
# SPOOL_PATH=/var/lib/edgeguard/spool.db
