FROM python:3.12-slim

WORKDIR /app

# Install Ansible + ansible-rulebook dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    ansible-core \
    ansible-rulebook \
    ansible-runner \
    requests

# Install EDA collection (provides ansible.eda.webhook source)
RUN ansible-galaxy collection install ansible.eda

# Copy rulebooks and inventory
COPY eda/ ./eda/
COPY automation/ ./automation/

EXPOSE 5000

CMD ["ansible-rulebook", "--rulebook", "eda/rulebooks/remediation.yml", "-i", "eda/inventory/hosts.yml", "--verbose"]
